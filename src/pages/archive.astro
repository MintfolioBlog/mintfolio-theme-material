---
import type { ListPageData, PageProps } from '@mintfolio/core/astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import type { MaterialSettings } from '../settings';
import MaterialLayout from '../layouts/MaterialLayout.astro';
import PostCard from '../components/PostCard.astro';
import Chip from '../components/Chip.astro';

interface Props extends PageProps<MaterialSettings, ListPageData> {}
const { theme, page } = Astro.props;
const [tags, categories, series] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories(), theme.taxonomy.series()]);
const total = page.pagination?.totalItems ?? page.posts.length;
const selected = (kind: 'tag' | 'category' | 'series', label: string): boolean => page.taxonomy?.kind === kind && page.taxonomy.label === label;
const eyebrow = page.taxonomy ? { tag: '标签', category: '分类', series: '系列' }[page.taxonomy.kind] : '全部文章';
---
<MaterialLayout theme={theme} page={page}>
  <div class="page">
    <header class="page-header">
      <p class="overline md-typescale-label-large">{eyebrow} · {total} 篇</p>
      <h1 class="page-header__title md-typescale-display-small">{page.title}</h1>
      {page.description && <p class="page-header__supporting md-typescale-body-large">{page.description}</p>}
    </header>

    <div class="archive-layout">
      <aside class="archive-filters" aria-label="搜索与筛选">
        <div class="search-card" id="site-search"><SearchPanel placeholder="搜索文章" /></div>
        <nav class="filter-group" aria-labelledby="filter-category">
          <h2 id="filter-category" class="filter-group__label md-typescale-title-small">分类</h2>
          <ul class="md-chip-set">
            <li><Chip href={theme.urls.archive()} kind="filter" selected={!page.taxonomy}>全部</Chip></li>
            {categories.map((term) => <li><Chip href={term.url} kind="filter" selected={selected('category', term.label)} count={term.count}>{term.label}</Chip></li>)}
          </ul>
        </nav>
        {tags.length > 0 && <nav class="filter-group" aria-labelledby="filter-tag">
          <h2 id="filter-tag" class="filter-group__label md-typescale-title-small">标签</h2>
          <ul class="md-chip-set">
            {tags.map((term) => <li><Chip href={term.url} kind="filter" selected={selected('tag', term.label)}>{term.label}</Chip></li>)}
          </ul>
        </nav>}
        {series.length > 0 && <nav class="filter-group" aria-labelledby="filter-series">
          <h2 id="filter-series" class="filter-group__label md-typescale-title-small">系列</h2>
          <ul class="md-chip-set">
            {series.map((term) => <li><Chip href={term.url} kind="filter" selected={selected('series', term.label)} count={term.count}>{term.label}</Chip></li>)}
          </ul>
        </nav>}
      </aside>

      <section aria-label="本页文章">
        {page.posts.length > 0
          ? <div class="card-list">{page.posts.map((post) => <PostCard post={post} variant="outlined" heading="h2" context="archive" language={theme.site.language} timezone={theme.site.blog?.timezone} />)}</div>
          : <div class="md-card md-card--outlined empty-state"><p class="md-typescale-body-large">这里还没有文章。</p></div>}
        {page.pagination && <Pagination pagination={page.pagination} />}
      </section>
    </div>
  </div>
</MaterialLayout>
