---
import type { PageProps, StaticPageData } from '@mintfolio/core/astro';
import Image from '@mintfolio/core/components/Image.astro';
import type { MaterialSettings } from '../settings';
import MaterialLayout from '../layouts/MaterialLayout.astro';
import Button from '../components/Button.astro';
import { formatDate } from '../lib/format';
import { socialIcon } from '../lib/icons';

interface Props extends PageProps<MaterialSettings, StaticPageData> {}
const { theme, page } = Astro.props;
const updated = page.updatedAt ? formatDate(page.updatedAt, theme.site.language, theme.site.blog?.timezone) : undefined;
const skills = theme.site.skills.filter((group) => group.items.length > 0);
---
<MaterialLayout theme={theme} page={page}>
  <div class="page">
    <header class="page-header">
      <p class="overline md-typescale-label-large">{page.id === 'about' ? '关于' : '页面'}{page.preview && ' · 本地预览'}</p>
      <h1 class="page-header__title md-typescale-display-small">{page.title}</h1>
      {page.description && <p class="page-header__supporting md-typescale-body-large">{page.description}</p>}
      {updated && <p class="supporting md-typescale-label-large">更新于 <time datetime={page.updatedAt}>{updated}</time></p>}
    </header>

    {page.body ? <article class="prose article-body" style="max-width: var(--app-measure)" set:html={page.body.html} /> : page.id === 'about' && <>
      <section class="md-card md-card--filled about-profile section" aria-labelledby="profile-heading">
        <Image class="about-profile__avatar" src={page.profile.avatar} alt={`${page.profile.name}的头像`} width={240} height={240} />
        <div class="about-profile__text">
          <h2 id="profile-heading" class="md-typescale-headline-medium">{page.profile.name}</h2>
          {page.profile.location && <p class="supporting md-typescale-body-medium">{page.profile.location}</p>}
          {page.profile.bio && <p class="md-typescale-body-large">{page.profile.bio}</p>}
          <div class="button-row">
            {theme.site.contact.email && <Button href={`mailto:${theme.site.contact.email}`} variant="filled" icon="mail">发送邮件</Button>}
            {theme.site.social.map((social) => { const { name, brand } = socialIcon(social); return <Button href={social.url} variant="outlined" rel="me" icon={name} brand={brand}>{social.platform}</Button>; })}
          </div>
        </div>
      </section>

      {skills.length > 0 && <section class="section" aria-labelledby="skills-heading">
        <div class="section-header"><h2 id="skills-heading" class="md-typescale-headline-small">技能与工具</h2></div>
        <div class="card-grid card-grid--two">
          {skills.map((group) => <div class="md-card md-card--outlined skill-card">
            <h3 class="md-typescale-title-medium">{group.category}</h3>
            <ul class="md-chip-set">{group.items.map((item) => <li><span class="md-chip">{item.name}</span></li>)}</ul>
          </div>)}
        </div>
      </section>}

      {theme.site.projects.length > 0 && <section class="section" aria-labelledby="projects-heading">
        <div class="section-header"><h2 id="projects-heading" class="md-typescale-headline-small">项目</h2></div>
        <div class="card-grid card-grid--two">
          {theme.site.projects.map((project) => <article class="md-card md-card--outlined project-card">
            <h3 class="md-typescale-title-large">{project.title}</h3>
            <p class="supporting md-typescale-body-medium">{project.description}</p>
            {project.tags.length > 0 && <ul class="md-chip-set">{project.tags.map((tag) => <li><span class="md-chip">{tag}</span></li>)}</ul>}
            {(project.link || project.repo) && <div class="button-row">
              {project.link && <Button href={project.link} variant="text" icon="open_in_new">访问项目</Button>}
              {project.repo && <Button href={project.repo} variant="text" icon="code">查看源码</Button>}
            </div>}
          </article>)}
        </div>
      </section>}
    </>}
  </div>
</MaterialLayout>
