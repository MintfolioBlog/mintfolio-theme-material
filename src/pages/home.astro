---
import type { HomePageData, PageProps } from '@mintfolio/core/astro';
import Image from '@mintfolio/core/components/Image.astro';
import type { MaterialSettings } from '../settings';
import MaterialLayout from '../layouts/MaterialLayout.astro';
import PostCard from '../components/PostCard.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
interface Props extends PageProps<MaterialSettings, HomePageData> {}
const { theme, page } = Astro.props;
const [feature, ...rest] = page.posts;
const recent = rest.slice(0, 6);
const { profile } = theme.site;
const language = theme.site.language;
const timezone = theme.site.blog?.timezone;
// The headline defaults to the site slogan; a custom headline moves the slogan into the supporting line.
const heroTitle = theme.settings.heroTitle || theme.site.description || theme.site.title;
const heroDescription = theme.settings.heroDescription || (theme.settings.heroTitle ? theme.site.description : '');
---
<MaterialLayout theme={theme} page={page}>
  <div class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        {theme.settings.heroEyebrow && <p class="overline md-typescale-label-large">{theme.settings.heroEyebrow}</p>}
        <h1 id="hero-title" class="hero__title md-typescale-display-medium">{heroTitle}</h1>
        {heroDescription && <p class="hero__description md-typescale-body-large">{heroDescription}</p>}
        <div class="button-row">
          <Button href={theme.urls.archive()} variant="filled" trailingIcon="arrow_forward">浏览文章</Button>
          <Button href={theme.urls.archive() + '#site-search'} variant="outlined" icon="search">搜索内容</Button>
        </div>
      </div>
      <aside class="md-card md-card--filled profile-card" aria-label="作者">
        <Image class="profile-card__avatar" src={profile.avatar} alt="" width={144} height={144} />
        <h2 class="profile-card__name md-typescale-title-large">{profile.name}</h2>
        {(profile.bio || profile.signature) && <p class="profile-card__bio md-typescale-body-medium">{profile.bio || profile.signature}</p>}
        <ul class="md-chip-set">
          {profile.location && <li><Chip href={theme.urls.page('about')} icon="explore">{profile.location}</Chip></li>}
          <li><Chip href={theme.urls.page('about')} icon="person">关于我</Chip></li>
        </ul>
      </aside>
    </section>

    {feature ? <section class="section" aria-labelledby="feature-heading">
      <div class="section-header"><h2 id="feature-heading" class="md-typescale-headline-small">精选阅读</h2></div>
      <PostCard post={feature} variant="elevated" layout="feature" heading="h3" context="feature" language={language} timezone={timezone} />
    </section> : <section class="section md-card md-card--outlined empty-state">
      <h2 class="md-typescale-title-large">第一篇故事，即将开始。</h2>
      <p class="supporting md-typescale-body-medium">这里还没有公开文章，欢迎之后回来看看。</p>
    </section>}

    {recent.length > 0 && <section class="section" aria-labelledby="latest-heading">
      <div class="section-header">
        <h2 id="latest-heading" class="md-typescale-headline-small">最近更新</h2>
        <Button href={theme.urls.archive()} variant="text" trailingIcon="arrow_forward">查看全部</Button>
      </div>
      <div class="card-grid card-grid--two">
        {recent.map((post) => <PostCard post={post} variant="outlined" context="recent" language={language} timezone={timezone} />)}
      </div>
    </section>}
  </div>
</MaterialLayout>
