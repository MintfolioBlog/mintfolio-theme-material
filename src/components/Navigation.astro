---
/**
 * Material 3 navigation by window size class:
 * - compact (below 600px): navigation bar, 80px, surface-container, 64×32 indicator;
 * - medium and up: navigation rail, 80px, surface, 56×32 indicator, search FAB on top.
 * The bar holds at most five destinations (the limit in the spec); further destinations
 * move into a modal bottom sheet opened from "更多". Without JavaScript the sheet is a
 * native details element, so every link stays reachable.
 */
import type { PageProps } from '@mintfolio/core/astro';
import type { MaterialSettings } from '../settings';
import Icon from './Icon.astro';
import { navigationIcon } from '../lib/icons';
interface Props extends PageProps<MaterialSettings> {}
const { theme, page } = Astro.props;
const home = theme.urls.home();
const archive = theme.urls.archive();
const searchHref = archive + '#site-search';

interface Destination { label: string; url: string; icon: string; selected: boolean }
// Core owns base-prefix normalization for both custom navigation and assets.
const withBase = (url: string): string => theme.urls.asset(url);
// Astro can serve equivalent routes with or without a trailing slash.
const destinationKey = (url: string): string => {
  try {
    const parsed = new URL(url, theme.site.url);
    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return url;
    return parsed.origin + parsed.pathname.replace(/\/+$/u, '') + parsed.search + parsed.hash;
  } catch { return url; }
};
// Theme setting first: the owner picks icon, link and label for every destination.
const configured = theme.settings.navigation
  .filter((item) => item.url.trim() && item.label.trim())
  .map((item) => ({ label: item.label.trim(), url: withBase(item.url.trim()), icon: item.icon.trim() }));
// Otherwise the site navigation, with home and the archive guaranteed and icons inferred.
const links = configured.length > 0 ? configured : theme.navigation.map((link) => ({ label: link.label, url: link.url, icon: '' }));
if (configured.length === 0) {
  if (!links.some((link) => destinationKey(link.url) === destinationKey(home))) links.unshift({ label: '首页', url: home, icon: '' });
  if (!links.some((link) => destinationKey(link.url) === destinationKey(archive))) links.splice(1, 0, { label: '文章', url: archive, icon: '' });
}
// Posts and taxonomy pages keep their parent destination selected, as hierarchy navigation expects.
const sectionUrl = page.kind === 'post' || page.kind === 'archive' ? archive : page.url;
const destinations: Destination[] = links.map((link) => {
  const key = destinationKey(link.url);
  const iconUrl = key === destinationKey(home) ? home : key === destinationKey(archive) ? archive : link.url;
  const icon = link.icon || navigationIcon({ ...link, url: iconUrl }, { home, archive });
  return { ...link, icon, selected: destinationKey(link.url) === destinationKey(sectionUrl) || destinationKey(link.url) === destinationKey(page.url) };
});
const BAR_LIMIT = 5;
const overflow = destinations.length > BAR_LIMIT;
const barItems = overflow ? destinations.slice(0, BAR_LIMIT - 1) : destinations;
const sheetItems = overflow ? destinations.slice(BAR_LIMIT - 1) : [];
const moreSelected = sheetItems.some((item) => item.selected);
---
{/* Persisted across client navigation, like an app shell; scripts/material.ts syncs the selection.
    Its own transition name keeps it in a separate snapshot layer above the cross-fading content. */}
<nav class="md-navigation-rail" aria-label="网站导航" data-navigation="rail" transition:persist="md-navigation-rail" transition:name="md-navigation-rail" transition:animate="none">
  <a class="md-fab" href={searchHref} aria-label="搜索文章" title="搜索文章">
    <md-elevation aria-hidden="true"></md-elevation>
    <md-focus-ring aria-hidden="true"></md-focus-ring>
    <md-ripple aria-hidden="true"></md-ripple>
    <Icon name="search" />
  </a>
  <ul class="md-navigation-rail__items">
    {destinations.map((item, index) => <li>
      <a class="md-nav-item" id={`rail-item-${index}`} data-nav-url={item.url} href={item.url} aria-current={item.selected ? 'page' : undefined}>
        <span class="md-nav-item__indicator">
          <md-focus-ring for={`rail-item-${index}`} aria-hidden="true"></md-focus-ring>
          <md-ripple for={`rail-item-${index}`} aria-hidden="true"></md-ripple>
          <Icon name={item.icon} class="md-nav-item__icon" /><Icon name={item.icon} filled class="md-nav-item__icon md-nav-item__icon--selected" />
        </span>
        <span class="md-nav-item__label md-typescale-label-medium">{item.label}</span>
      </a>
    </li>)}
  </ul>
</nav>

<nav class="md-navigation-bar" aria-label="网站导航" data-navigation="bar" transition:persist="md-navigation-bar" transition:name="md-navigation-bar" transition:animate="none">
  <ul class="md-navigation-bar__items">
    {barItems.map((item, index) => <li>
      <a class="md-nav-item" id={`bar-item-${index}`} data-nav-url={item.url} href={item.url} aria-current={item.selected ? 'page' : undefined}>
        <span class="md-nav-item__indicator">
          <md-focus-ring for={`bar-item-${index}`} aria-hidden="true"></md-focus-ring>
          <md-ripple for={`bar-item-${index}`} aria-hidden="true"></md-ripple>
          <Icon name={item.icon} class="md-nav-item__icon" /><Icon name={item.icon} filled class="md-nav-item__icon md-nav-item__icon--selected" />
        </span>
        <span class="md-nav-item__label md-typescale-label-medium">{item.label}</span>
      </a>
    </li>)}
    {overflow && <li>
      <details class="md-bottom-sheet" data-bottom-sheet>
        <summary class="md-nav-item" id="bar-item-more" data-nav-url="more" aria-current={moreSelected ? 'page' : undefined}>
          <span class="md-nav-item__indicator">
            <md-focus-ring for="bar-item-more" aria-hidden="true"></md-focus-ring>
            <md-ripple for="bar-item-more" aria-hidden="true"></md-ripple>
            <Icon name="menu" />
          </span>
          <span class="md-nav-item__label md-typescale-label-medium">更多</span>
        </summary>
        <div class="md-bottom-sheet__scrim" data-sheet-scrim aria-hidden="true"></div>
        <div class="md-bottom-sheet__container" role="group" aria-label="更多导航">
          <span class="md-bottom-sheet__handle" aria-hidden="true"></span>
          <ul class="md-list">
            {sheetItems.map((item) => <li>
              <a class="md-list-item" data-nav-url={item.url} href={item.url} aria-current={item.selected ? 'page' : undefined}>
                <md-focus-ring aria-hidden="true"></md-focus-ring>
                <md-ripple aria-hidden="true"></md-ripple>
                <Icon name={item.icon} />
                <span class="md-typescale-body-large">{item.label}</span>
              </a>
            </li>)}
            <li>
              <a class="md-list-item" href={searchHref}>
                <md-focus-ring aria-hidden="true"></md-focus-ring>
                <md-ripple aria-hidden="true"></md-ripple>
                <Icon name="search" /><span class="md-typescale-body-large">搜索文章</span>
              </a>
            </li>
            <li>
              <a class="md-list-item" href={theme.urls.rss()}>
                <md-focus-ring aria-hidden="true"></md-focus-ring>
                <md-ripple aria-hidden="true"></md-ripple>
                <Icon name="rss_feed" /><span class="md-typescale-body-large">订阅 RSS</span>
              </a>
            </li>
          </ul>
        </div>
      </details>
    </li>}
  </ul>
</nav>
