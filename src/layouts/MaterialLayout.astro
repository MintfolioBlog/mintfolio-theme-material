---
import faviconUrl from '../assets/favicon.svg?url';
/**
 * Document shell. Color roles come from Material dynamic color at build time
 * (src/lib/color.ts); typography from the official @material/web typescale CSS;
 * Roboto from Fontsource. Navigation adapts to the window size class.
 */
import type { PageProps } from '@mintfolio/core/astro';
import SeoHead from '@mintfolio/core/components/SeoHead.astro';
import type { MaterialSettings } from '../settings';
import Navigation from '../components/Navigation.astro';
import TopAppBar from '../components/TopAppBar.astro';
import Button from '../components/Button.astro';
import { ClientRouter } from 'astro:transitions';
import { colorSchemeCss } from '../lib/color';
import { fadeThrough } from '../lib/motion';
import { socialIcon } from '../lib/icons';
import '@fontsource-variable/roboto/wght.css';
import '@material/web/typography/md-typescale-styles.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/prose.css';
interface Props extends PageProps<MaterialSettings> { back?: { href: string; label: string } }
const { theme, page, back } = Astro.props;
const colors = colorSchemeCss(theme.settings);
---
<!doctype html>
{/* Only the content pane animates; navigation persists and the root does not cross-fade. */}
<html lang={page.seo.language} class="material" data-appearance={theme.settings.appearance} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead seo={page.seo} faviconFallback={faviconUrl} />
    <style is:inline set:html={colors}></style>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳转到主要内容</a>
    <Navigation theme={theme} page={page} />
    <div class="app-frame">
      <TopAppBar theme={theme} page={page} back={back} />
      <div class="app-content" transition:name="md-content" transition:animate={fadeThrough}>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          {(theme.site.profile.signature || theme.site.description) && <p class="md-typescale-body-large site-footer__signature">{theme.site.profile.signature || theme.site.description}</p>}
          <nav class="site-footer__links" aria-label="社交与订阅">
            {theme.site.social.map((link) => { const { name, brand } = socialIcon(link); return <Button href={link.url} variant="text" rel="me" icon={name} brand={brand}>{link.platform}</Button>; })}
            <Button href={theme.urls.rss()} variant="text" icon="rss_feed">RSS</Button>
            <Button href={theme.urls.sitemap()} variant="text">Sitemap</Button>
          </nav>
          <p class="md-typescale-body-small site-footer__legal">© {new Date().getFullYear()} {theme.site.profile.name} · Mintfolio / Material</p>
          {theme.site.icp && <p class="md-typescale-body-small site-footer__legal"><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{theme.site.icp}</a></p>}
        </div>
      </footer>
      </div>
    </div>
    <script>
      import '../scripts/material';
    </script>
  </body>
</html>
